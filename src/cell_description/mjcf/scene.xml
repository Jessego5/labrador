<!--
  This is the MuJoCo scene for the manipulation cell, the file mujoco_ros2_control loads. It is
  hand-written and holds the table, the floor, the lights, an overhead view and the objects. The
  robot and the workspace furniture are included from files that scripts regenerate
  (ur5e_2f85.xml from Menagerie, workspace.xml from config/workspace.yaml), so those are edited
  through their sources and not here. The world frame is the `table` frame, with its origin at
  the robot base on the table top (z = 0), x pointing away from the robot and z up. The objects
  start at the poses written below.
-->
<mujoco model="manipulation_cell">
  <include file="ur5e_2f85.xml"/>
  <!-- trays, bins and fixtures, generated from config/workspace.yaml -->
  <include file="workspace.xml"/>

  <statistic center="0.4 0 0.2" extent="1.0"/>

  <visual>
    <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0"/>
    <rgba haze="0.15 0.25 0.35 1"/>
    <global azimuth="150" elevation="-25" offwidth="1280" offheight="960"/>
  </visual>

  <asset>
    <texture type="skybox" builtin="gradient" rgb1="0.3 0.5 0.7" rgb2="0 0 0" width="512" height="3072"/>
    <texture type="2d" name="groundplane" builtin="checker" mark="edge" rgb1="0.2 0.3 0.4"
             rgb2="0.1 0.2 0.3" markrgb="0.8 0.8 0.8" width="300" height="300"/>
    <material name="groundplane" texture="groundplane" texuniform="true" texrepeat="5 5" reflectance="0.1"/>
    <material name="table" rgba="0.75 0.72 0.68 1"/>
    <material name="red" rgba="0.85 0.1 0.1 1"/>
    <material name="green" rgba="0.1 0.7 0.2 1"/>
    <material name="blue" rgba="0.1 0.3 0.85 1"/>
    <material name="yellow" rgba="0.9 0.8 0.1 1"/>
  </asset>

  <default>
    <default class="object">
      <geom condim="4" friction="1 0.01 0.001" solref="0.005 1" density="800"/>
    </default>
  </default>

  <worldbody>
    <light pos="0.4 0 1.5" dir="0 0 -1" directional="true"/>
    <geom name="floor" type="plane" pos="0 0 -0.75" size="0 0 0.05" material="groundplane"/>

    <!-- the table, with its top surface at z = 0 and the robot mounted near the back edge -->
    <geom name="table_top" type="box" pos="0.35 0 -0.02" size="0.55 0.65 0.02" material="table"/>
    <geom name="table_leg_1" type="box" pos="-0.15 -0.6 -0.385" size="0.025 0.025 0.345" material="table"/>
    <geom name="table_leg_2" type="box" pos="-0.15 0.6 -0.385" size="0.025 0.025 0.345" material="table"/>
    <geom name="table_leg_3" type="box" pos="0.85 -0.6 -0.385" size="0.025 0.025 0.345" material="table"/>
    <geom name="table_leg_4" type="box" pos="0.85 0.6 -0.385" size="0.025 0.025 0.345" material="table"/>

    <!-- an overhead view looking straight down at the workspace -->
    <camera name="overhead" pos="0.45 0 1.0" xyaxes="0 -1 0 1 0 0" fovy="58"/>

    <!-- the objects: three 40 mm cubes, four cylinders 30 mm across and 50 mm tall, and the peg,
         20 mm across and 60 mm long -->
    <body name="cube_red_0" pos="0.40 0.15 0.02">
      <freejoint name="cube_red_0"/>
      <geom class="object" type="box" size="0.02 0.02 0.02" material="red"/>
    </body>
    <body name="cube_red_1" pos="0.30 -0.20 0.02">
      <freejoint name="cube_red_1"/>
      <geom class="object" type="box" size="0.02 0.02 0.02" material="red"/>
    </body>
    <body name="cube_green_0" pos="0.55 -0.25 0.02">
      <freejoint name="cube_green_0"/>
      <geom class="object" type="box" size="0.02 0.02 0.02" material="green"/>
    </body>
    <body name="cyl_blue_0" pos="0.30 -0.05 0.025">
      <freejoint name="cyl_blue_0"/>
      <geom class="object" type="cylinder" size="0.015 0.025" material="blue"/>
    </body>
    <body name="cyl_blue_1" pos="0.62 0.20 0.025">
      <freejoint name="cyl_blue_1"/>
      <geom class="object" type="cylinder" size="0.015 0.025" material="blue"/>
    </body>
    <body name="cyl_blue_2" pos="0.70 -0.15 0.025">
      <freejoint name="cyl_blue_2"/>
      <geom class="object" type="cylinder" size="0.015 0.025" material="blue"/>
    </body>
    <body name="cyl_blue_3" pos="0.40 -0.30 0.025">
      <freejoint name="cyl_blue_3"/>
      <geom class="object" type="cylinder" size="0.015 0.025" material="blue"/>
    </body>
    <body name="peg_0" pos="0.25 0.05 0.03">
      <freejoint name="peg_0"/>
      <geom class="object" type="cylinder" size="0.010 0.03" material="yellow"/>
    </body>
  </worldbody>
</mujoco>
