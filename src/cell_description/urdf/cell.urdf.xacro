<?xml version="1.0"?>
<!--
  This is the robot description for the cell, a UR5e with a Robotiq 2F-85 on a table, simulated
  in MuJoCo through mujoco_ros2_control. MoveIt, robot_state_publisher and the controllers all
  read it, while MuJoCo itself runs mjcf/scene.xml, so the two have to describe the same robot:
  the joint names must match mjcf/ur5e_2f85.xml, because the MuJoCo actuators are named after
  their joints. The world frame is the table frame, with the robot base at the origin on the
  table top. The arm takes its link lengths from config/ur5e_mujoco_kinematics.yaml, Menagerie's
  rather than UR's calibration, so URDF and MJCF forward kinematics agree exactly, and its joint
  ranges from config/ur5e_joint_limits.yaml; scripts/check_fk.py checks the agreement.
-->
<robot name="cell" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:arg name="headless" default="false"/>
  <xacro:arg name="mujoco_model" default="$(find cell_description)/mjcf/scene.xml"/>

  <xacro:include filename="$(find ur_description)/urdf/ur_macro.xacro"/>
  <xacro:include filename="$(find robotiq_description)/urdf/robotiq_2f_85_macro.urdf.xacro"/>

  <!-- gripper mounting, measured from the MJCF by scripts/build_mjcf.py -->
  <xacro:property name="gripper_mount_z" value="0.0108"/>
  <xacro:property name="gripper_yaw" value="${pi}"/>
  <xacro:property name="tcp_z" value="0.1558"/>

  <!-- home pose: the arm raised above the workspace with the gripper pointing down -->
  <xacro:property name="home_shoulder_pan" value="0.0"/>
  <xacro:property name="home_shoulder_lift" value="-1.5708"/>
  <xacro:property name="home_elbow" value="1.5708"/>
  <xacro:property name="home_wrist_1" value="-1.5708"/>
  <xacro:property name="home_wrist_2" value="-1.5708"/>
  <xacro:property name="home_wrist_3" value="0.0"/>

  <link name="world"/>
  <link name="table"/>
  <joint name="world_to_table" type="fixed">
    <parent link="world"/>
    <child link="table"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <xacro:ur_robot
    name="ur"
    tf_prefix=""
    parent="table"
    joint_limits_parameters_file="$(find cell_description)/config/ur5e_joint_limits.yaml"
    kinematics_parameters_file="$(find cell_description)/config/ur5e_mujoco_kinematics.yaml"
    physical_parameters_file="$(find ur_description)/config/ur5e/physical_parameters.yaml"
    visual_parameters_file="$(find ur_description)/config/ur5e/visual_parameters.yaml">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur_robot>

  <xacro:robotiq_gripper name="RobotiqGripper" prefix="" parent="tool0" include_ros2_control="false">
    <origin xyz="0 0 ${gripper_mount_z}" rpy="0 0 ${gripper_yaw}"/>
  </xacro:robotiq_gripper>

  <!-- The tool centre point, midway between the finger pads, 0.1558 m from tool0 and rotated
       -90 degrees about z: z is the approach direction and the fingers close along y. It is the
       same frame as the MuJoCo site robotiq_pinch. -->
  <link name="tcp"/>
  <joint name="tool0_to_tcp" type="fixed">
    <parent link="tool0"/>
    <child link="tcp"/>
    <origin xyz="0 0 ${tcp_z}" rpy="0 0 ${-pi/2}"/>
  </joint>

  <!-- The overhead camera's optical frame (x right, y down, z forward), the same as the MJCF
       camera "overhead" at (0.45, 0, 1.0) looking straight down. scripts/check_fk.py checks
       that the two agree. -->
  <link name="overhead_camera_optical_frame"/>
  <joint name="table_to_overhead_camera" type="fixed">
    <parent link="table"/>
    <child link="overhead_camera_optical_frame"/>
    <origin xyz="0.45 0 1.0" rpy="${pi} 0 ${-pi/2}"/>
  </joint>

  <xacro:macro name="arm_joint" params="name initial">
    <joint name="${name}">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">${initial}</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </xacro:macro>

  <ros2_control name="MujocoSystem" type="system">
    <hardware>
      <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
      <param name="mujoco_model">$(arg mujoco_model)</param>
      <param name="headless">$(arg headless)</param>
      <param name="sim_speed_factor">1.0</param>
    </hardware>
    <xacro:arm_joint name="shoulder_pan_joint" initial="${home_shoulder_pan}"/>
    <xacro:arm_joint name="shoulder_lift_joint" initial="${home_shoulder_lift}"/>
    <xacro:arm_joint name="elbow_joint" initial="${home_elbow}"/>
    <xacro:arm_joint name="wrist_1_joint" initial="${home_wrist_1}"/>
    <xacro:arm_joint name="wrist_2_joint" initial="${home_wrist_2}"/>
    <xacro:arm_joint name="wrist_3_joint" initial="${home_wrist_3}"/>
    <!-- The 2F-85 driver joint, commanded in radians: 0 is open and 0.8 closed. The other finger
         joints are mimics of it. -->
    <joint name="robotiq_85_left_knuckle_joint">
      <command_interface name="position"/>
      <state_interface name="position">
        <param name="initial_value">0.0</param>
      </state_interface>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
    </joint>
  </ros2_control>
</robot>
