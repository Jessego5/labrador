Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.1
      Plane Cell Count: 20
      Reference Frame: table
    - Class: rviz_default_plugins/RobotModel
      Name: RobotModel
      Enabled: true
      Description Source: Topic
      Description Topic:
        Value: /robot_description
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Show Names: false
      Show Arrows: false
      Marker Scale: 0.06
      Frames:
        All Enabled: true
    - Class: rviz_default_plugins/MarkerArray
      Name: Workspace
      Enabled: true
      Topic:
        Value: /workspace/markers
        Depth: 5
        Durability Policy: Transient Local
        Reliability Policy: Reliable
  Global Options:
    Fixed Frame: world
    Frame Rate: 30
  Tools:
    - Class: rviz_default_plugins/MoveCamera
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Distance: 1.5
      Focal Point: {X: 0.45, Y: 0.05, Z: 0.05}
      Pitch: 0.6
      Yaw: 2.6
      Target Frame: world
Window Geometry:
  Width: 1280
  Height: 800
