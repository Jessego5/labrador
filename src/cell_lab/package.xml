<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- The run dependencies are what lab_node talks to: the simulator's free-joint messages and
     service for moving the twins, the cell's LabReset service type, and cell_description for
     config/lab/lab.yaml and the lab's workspace layout. -->
<package format="3">
  <name>cell_lab</name>
  <version>0.1.0</version>
  <description>The lab scene's chemistry: sample states, reactions and dosing, shown in MuJoCo by swapping visual twins.</description>
  <maintainer email="dev@example.com">cell developer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>cell_description</exec_depend>
  <exec_depend>cell_interfaces</exec_depend>
  <exec_depend>mujoco_ros2_control_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <test_depend>ament_index_python</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
