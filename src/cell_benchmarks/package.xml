<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<!-- This is the package manifest for cell_benchmarks, the Python package that lays out seeded
     random scenes and runs the perception and insertion acceptance trials against a running
     cell. It needs cell_description for objects.yaml and workspace.yaml, cell_interfaces for
     the skill actions, and mujoco_ros2_control_msgs to read
     ground truth and move objects in the simulator. -->
<package format="3">
  <name>cell_benchmarks</name>
  <version>0.1.0</version>
  <description>Scene randomization and benchmark runners for the manipulation cell.</description>
  <maintainer email="dev@example.com">cell developer</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>cell_description</exec_depend>
  <exec_depend>cell_interfaces</exec_depend>
  <exec_depend>mujoco_ros2_control_msgs</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
