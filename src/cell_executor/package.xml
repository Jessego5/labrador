<?xml version="1.0"?>
<!-- cell_description is needed at run time for config/workspace.yaml, which the executor loads
     to check targets and allocate bin drop spots; python3-zmq is for tree_status.py. -->
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cell_executor</name>
  <version>0.1.0</version>
  <description>Task executor: YAML task files run as BehaviorTree.CPP trees over the cell skills,
    with pause/resume/abort, failure policies, run logs and a Groot2 live view.</description>
  <maintainer email="dev@example.com">cell developer</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>ament_index_cpp</depend>
  <depend>behaviortree_cpp</depend>
  <depend>cell_interfaces</depend>
  <depend>cell_workspace</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_action</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>yaml-cpp</depend>
  <exec_depend>cell_description</exec_depend>
  <exec_depend>python3-zmq</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
