# This is the Place skill for the object the robot is holding: it approaches above the target,
# descends, releases and retreats. A target is either a workspace name or an explicit pose.
string target_name                      # workspace target, e.g. "tray_1/C4" or "bin_a"
geometry_msgs/PoseStamped target_pose   # used when target_name is empty: where the object's
                                        # bottom centre should end up
bool use_compliance                     # not implemented yet; the place uses position control
---
bool success
cell_interfaces/SkillError error
string message
geometry_msgs/PoseStamped final_tcp_pose
---
string phase                            # approach, descend, release, retreat
float32 progress
